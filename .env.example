# Copy to .env and fill in. Never commit .env. Secrets live here, never in agent.yaml.

# Twilio (telephony). Buy a Voice-capable number; verify your own number on trial accounts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Deepgram (streaming STT)
DEEPGRAM_API_KEY=

# ElevenLabs (streaming TTS, Turbo model)
ELEVENLABS_API_KEY=

# Anthropic (Claude Haiku LLM) - used when agent.yaml llm.provider is "claude" (default)
ANTHROPIC_API_KEY=

# OpenRouter (any model) - used when agent.yaml llm.provider is "openrouter"
OPENROUTER_API_KEY=

# Cal.com (real booking during the call) - used when agent.yaml booking.provider is "calcom".
# Create it at cal.com > Settings > Developer > API keys.
CALCOM_API_KEY=

# Optional: public base URL for Twilio Media Streams callbacks (e.g. your ngrok https URL).
# Used to build the wss:// stream URL. Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# Optional: server bind host/port for the FastAPI app
HOST=0.0.0.0
PORT=8000

# --- Self-hosted platform (instance settings). Generate secrets with: voiceagent init-instance ---
# Your domain (an A record pointing at this server). Caddy gets the HTTPS certificate for it.
DOMAIN=
# Postgres password (docker compose builds DATABASE_URL from it).
POSTGRES_PASSWORD=
# Calls the instance runs at once, across all workspaces. 1 vCPU / 2 GB handles about 3.
MAX_CONCURRENT_CALLS=3
# Let connectors reach private/LAN addresses (e.g. a CRM on the same server). Off by default.
ALLOW_PRIVATE_CONNECTOR_URLS=false
# Postgres in production (docker compose sets this); SQLite for local dev.
DATABASE_URL=sqlite+aiosqlite:///./voiceagent.db
SECRET_KEY=
# Encrypts every workspace's provider keys at rest. BACK IT UP: losing it loses those keys.
ENCRYPTION_KEY=
# Anyone can sign up when true. The first user is always allowed (and becomes instance admin).
ALLOW_SIGNUPS=false

